#!/usr/bin/env bash
# Independent oracle: native perf exports text; Inferno folds/renders that text.
# Run inside devenv after building the release binary. Never skips missing inputs.
set -euo pipefail
export LC_ALL=C

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
target=${CARGO_TARGET_DIR:-$repo/target}
recording=${1:-${PERF_PARITY_DATA:-}}
pyroclast=${PYROCLAST_BIN:-$target/release/pyroclast}
perf=${PERF_BIN:-perf}
if [ -n "$recording" ] && [ ! -f "$recording" ]; then
    echo "missing native parity recording: $recording" >&2
    exit 1
fi
[ -x "$pyroclast" ] || { echo "missing release binary: $pyroclast (run cargo build --release --bin pyroclast)" >&2; exit 1; }
for tool in "$perf" inferno-collapse-perf inferno-flamegraph diff sort; do
    command -v "$tool" >/dev/null || { echo "missing parity tool: $tool" >&2; exit 1; }
done

if [ -n "${PERF_PARITY_OUT:-}" ]; then
    scratch=$PERF_PARITY_OUT
    mkdir -p "$scratch"
else
    mkdir -p "$target"
    scratch=$(mktemp -d "$target/perf-parity.XXXXXX")
    trap 'rm -rf "$scratch"' EXIT
fi
compare() {
    if ! diff -u "$1" "$2" > "$scratch/mismatch.diff"; then
        head -60 "$scratch/mismatch.diff" >&2
        echo "native parity mismatch: $1 versus $2" >&2
        return 1
    fi
}
check_recording() {
    local recording=$1 scratch=$2 mode symbolizer
    for mode in inline no-inline; do
        mkdir -p "$scratch/$mode"
        "$perf" script --force "--$mode" -i "$recording" > "$scratch/$mode/native.script"
        inferno-collapse-perf "$scratch/$mode/native.script" | sort > "$scratch/$mode/native.folded"
        [ -s "$scratch/$mode/native.folded" ] || { echo "native perf oracle produced no stacks ($mode)" >&2; exit 1; }
        inferno-flamegraph --title 'Native perf parity' - < "$scratch/$mode/native.folded" > "$scratch/$mode/native.svg"
        for symbolizer in rust-addr2line addr2line; do
            "$pyroclast" plumbing perf-script "--$mode" --symbolizer "$symbolizer" "$recording" > "$scratch/$mode/$symbolizer.script"
            compare "$scratch/$mode/native.script" "$scratch/$mode/$symbolizer.script"
            "$pyroclast" plumbing fold --count-periods "--$mode" --symbolizer "$symbolizer" "$recording" | sort > "$scratch/$mode/$symbolizer.folded"
            compare "$scratch/$mode/native.folded" "$scratch/$mode/$symbolizer.folded"
            inferno-flamegraph --title 'Native perf parity' - < "$scratch/$mode/$symbolizer.folded" > "$scratch/$mode/$symbolizer.svg"
            compare "$scratch/$mode/native.svg" "$scratch/$mode/$symbolizer.svg"
            echo "native-perf-parity symbolizer=$symbolizer mode=$mode script=true folded=true svg=true"
        done
    done
}
if [ -n "$recording" ]; then
    check_recording "$recording" "$scratch"
else
    bash "$repo/scripts/generate-perf-parity" "$scratch/inputs"
    for capture in dwarf fp; do
        check_recording "$scratch/inputs/$capture.perf.data" "$scratch/$capture"
    done
fi
