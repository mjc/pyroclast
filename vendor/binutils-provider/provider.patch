+static const struct bfd_input_provider *input_provider;
+
+int
+bfd_set_input_provider (const struct bfd_input_provider *provider)
+{
+  if (input_provider || !provider || !provider->open_snapshot
+      || !provider->canonical_name)
+    {
+      errno = EINVAL;
+      return -1;
+    }
+  input_provider = provider;
+  return 0;
+}
+
+int
+bfd_input_provider_active (void)
+{
+  return input_provider != NULL;
+}
+
+FILE *
+bfd_input_fopen (const char *filename, const char *mode, int borrowed_fd)
+{
+  int fd;
+  FILE *stream;
+  if (strcmp (mode, "r") != 0 && strcmp (mode, "rb") != 0)
+    {
+      errno = EROFS;
+      return NULL;
+    }
+  fd = input_provider->open_snapshot (input_provider->context, filename,
+                                      borrowed_fd);
+  if (fd < 0)
+    return NULL;
+  stream = fdopen (fd, mode);
+  if (!stream)
+    {
+      int error = errno;
+      close (fd);
+      errno = error;
+    }
+  return close_on_exec (stream);
+}
+
+int
+bfd_input_open (const char *filename, int flags)
+{
+  if (!input_provider)
+    return open (filename, flags);
+  if ((flags & O_ACCMODE) != O_RDONLY || (flags & (O_CREAT | O_TRUNC)))
+    {
+      errno = EROFS;
+      return -1;
+    }
+  return input_provider->open_snapshot (input_provider->context, filename, -1);
+}
+
+char *
+bfd_input_canonical_name (const char *filename)
+{
+  if (!input_provider)
+    return lrealpath (filename);
+  return input_provider->canonical_name (input_provider->context, filename);
+}
+
 FILE *
 _bfd_real_fopen (const char *filename, const char *modes)
 {
+  if (input_provider)
+    return bfd_input_fopen (filename, modes, -1);
 #ifdef VMS
   char *vms_attr;
 
