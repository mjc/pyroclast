diff -ruN baseline/binutils/snapshot-provider.h source/binutils/snapshot-provider.h
--- baseline/binutils/snapshot-provider.h	1969-12-31 17:00:00.000000000 -0700
+++ source/binutils/snapshot-provider.h	2026-10-08 18:39:50.856541682 -0600
@@ -0,0 +1,188 @@
+/* Linux proof adapter; transport and session ownership belong to the caller. */
+#include "bfd-input-provider.h"
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <unistd.h>
+
+struct snapshot_entry
+{
+  char *name;
+  char *canonical;
+  int fd;
+  int error;
+  struct snapshot_entry *next;
+};
+
+static struct snapshot_entry *snapshots;
+
+static int
+snapshot_copy (int input)
+{
+  struct stat st;
+  unsigned char buffer[65536];
+  off_t offset = 0;
+  int output, error;
+
+  if (fstat (input, &st) < 0)
+    return -1;
+  if (!S_ISREG (st.st_mode) || st.st_size < 0)
+    {
+      errno = EINVAL;
+      return -1;
+    }
+  output = memfd_create ("bfd-input", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+  if (output < 0)
+    return -1;
+  /* Read the observed finite extent, never a growing stream's EOF. */
+  while (offset < st.st_size)
+    {
+      size_t count = sizeof buffer;
+      ssize_t got;
+      size_t written = 0;
+      if (st.st_size - offset < (off_t) count)
+        count = st.st_size - offset;
+      do
+        got = pread (input, buffer, count, offset);
+      while (got < 0 && errno == EINTR);
+      if (got <= 0)
+        {
+          if (got == 0)
+            errno = EIO;
+          goto fail;
+        }
+      while (written < (size_t) got)
+        {
+          ssize_t put = write (output, buffer + written, got - written);
+          if (put < 0 && errno == EINTR)
+            continue;
+          if (put <= 0)
+            {
+              if (put == 0)
+                errno = EIO;
+              goto fail;
+            }
+          written += put;
+        }
+      offset += got;
+    }
+  if (fcntl (output, F_ADD_SEALS,
+             F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL) < 0)
+    goto fail;
+  return output;
+fail:
+  error = errno;
+  close (output);
+  errno = error;
+  return -1;
+}
+
+static struct snapshot_entry *
+snapshot_lookup (const char *name, int borrowed_fd)
+{
+  struct snapshot_entry *entry, *other;
+  int input;
+  for (entry = snapshots; entry; entry = entry->next)
+    if (strcmp (name, entry->name) == 0)
+      return entry;
+
+  entry = xcalloc (1, sizeof *entry);
+  entry->name = xstrdup (name);
+  entry->canonical = lrealpath (name);
+  entry->fd = -1;
+  entry->next = snapshots;
+  snapshots = entry;
+  if (!entry->canonical)
+    {
+      entry->error = errno ? errno : ENOMEM;
+      return entry;
+    }
+  /* Bind each logical alias once, including failed candidates. */
+  for (other = entry->next; other; other = other->next)
+    if (other->canonical
+        && strcmp (entry->canonical, other->canonical) == 0)
+      {
+        entry->error = other->error;
+        if (other->fd >= 0)
+          {
+            entry->fd = fcntl (other->fd, F_DUPFD_CLOEXEC, 0);
+            if (entry->fd < 0)
+              entry->error = errno;
+          }
+        return entry;
+      }
+
+  input = borrowed_fd;
+  if (input < 0)
+    input = open (name, O_RDONLY | O_NONBLOCK | O_NOCTTY | O_CLOEXEC);
+  if (input < 0)
+    entry->error = errno;
+  else
+    {
+      entry->fd = snapshot_copy (input);
+      if (entry->fd < 0)
+        entry->error = errno;
+      if (borrowed_fd < 0)
+        close (input);
+    }
+  return entry;
+}
+
+static int
+snapshot_open (void *context ATTRIBUTE_UNUSED, const char *name, int borrowed_fd)
+{
+  struct snapshot_entry *entry = snapshot_lookup (name, borrowed_fd);
+  char descriptor[64];
+  if (entry->fd < 0)
+    {
+      errno = entry->error;
+      return -1;
+    }
+  /* Reopen the held sealed object, not its logical filesystem name.
+     dup would share offsets across BFD, CRC probes and plugin consumers. */
+  snprintf (descriptor, sizeof descriptor, "/proc/self/fd/%d", entry->fd);
+  return open (descriptor, O_RDONLY | O_CLOEXEC);
+}
+
+static char *
+snapshot_canonical (void *context ATTRIBUTE_UNUSED, const char *name)
+{
+  struct snapshot_entry *entry = snapshot_lookup (name, -1);
+  if (!entry->canonical)
+    {
+      errno = entry->error;
+      return NULL;
+    }
+  return xstrdup (entry->canonical);
+}
+
+static void
+snapshot_provider_init (const char *file_name)
+{
+  static const struct bfd_input_provider provider =
+    { NULL, snapshot_open, snapshot_canonical };
+  const char *fd_text = getenv ("PYRO_PRIMARY_FD");
+  const char *name = getenv ("PYRO_PRIMARY_NAME");
+  const char *canonical = getenv ("PYRO_PRIMARY_CANONICAL");
+  struct snapshot_entry *primary;
+  char *end;
+  long fd;
+  if (!fd_text)
+    fatal ("selected primary descriptor required");
+  errno = 0;
+  fd = strtol (fd_text, &end, 10);
+  if (errno || !*fd_text || *end || fd < 0 || fd > INT_MAX
+      || !name || strcmp (file_name, name) != 0 || !canonical)
+    fatal ("invalid selected primary descriptor or filename");
+  primary = xcalloc (1, sizeof *primary);
+  primary->name = xstrdup (name);
+  primary->canonical = xstrdup (canonical);
+  primary->fd = snapshot_copy (fd);
+  if (primary->fd < 0)
+    fatal ("cannot capture selected primary: %s", strerror (errno));
+  close (fd);
+  snapshots = primary;
+  if (bfd_set_input_provider (&provider) < 0)
+    fatal ("cannot install input provider: %s", strerror (errno));
+}
diff -ruN baseline/include/bfd-input-provider.h source/include/bfd-input-provider.h
--- baseline/include/bfd-input-provider.h	1969-12-31 17:00:00.000000000 -0700
+++ source/include/bfd-input-provider.h	2026-10-08 18:27:43.462648939 -0600
@@ -0,0 +1,22 @@
+/* Private, single-process read-only input provider for pinned GNU BFD. */
+#ifndef BFD_INPUT_PROVIDER_H
+#define BFD_INPUT_PROVIDER_H
+
+#include <stdio.h>
+
+struct bfd_input_provider
+{
+  void *context;
+  /* Return an owned independent read-only FD; do not consume borrowed_fd. */
+  int (*open_snapshot) (void *, const char *, int borrowed_fd);
+  /* Return a malloc-owned, stable original canonical filename. */
+  char *(*canonical_name) (void *, const char *);
+};
+
+extern int bfd_set_input_provider (const struct bfd_input_provider *);
+extern int bfd_input_provider_active (void);
+extern FILE *bfd_input_fopen (const char *, const char *, int);
+extern int bfd_input_open (const char *, int);
+extern char *bfd_input_canonical_name (const char *);
+
+#endif
